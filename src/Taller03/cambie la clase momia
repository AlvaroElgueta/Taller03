package Taller03;

public class Momia extends Monstruo implements Regenerable, Furioso {

    private int largoVendajes;

    public Momia(int vida, int velocidad, int fuerza, int resistencia, int largoVendajes) {
        super(vida, velocidad, fuerza, resistencia);
        this.largoVendajes = largoVendajes;
    }

    public int getLargoVendajes() {
        return largoVendajes;
    }

    public void setLargoVendajes(int largoVendajes) {
        this.largoVendajes = largoVendajes;
    }

    @Override
    public String getTipo() {
        return "Momia";
    }

    @Override
    public String getInformacion() {
        return getTipo() + " | " + getInformacionBase() + " | Longitud de vendajes: "
                + largoVendajes;
    }

    @Override
    public String regenerarse() {
        return "La momia utiliza sus vendajes para regenerarse";
    }

    @Override
    public String enfurecerse() {
        return "La momia se enfurece";
    }

    @Override
    public double calcularCarrera() {
        return (double) getVelocidad() * 100 / (100 + largoVendajes);
    }

    @Override
    public double calcularCaza() {
        return (double) largoVendajes * getFuerza() / 200;
    }

    @Override
    public double calcularLanzamiento() {
        return getFuerza() + (double) largoVendajes / 10;
    }

    @Override
    public double calcularAmanecer() {
        return (double) (getResistencia() + getVida()) / 2
                * (1 + (double) largoVendajes / 300);
    }
}
